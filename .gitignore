# ============================================================
# 世界历史学习 · 时间轴应用 — 发布版 .gitignore
# 原则：
#   1) 不上传任何QQ机器人凭证 / Token / 真实学习数据
#   2) 不包含开发机上的无关目录与历史快照
#   3) 运行时自动生成的文件一律排除（server.py 首次启动会自动建空骨架）
# ============================================================

# ---- QQ 机器人访问凭证（含真实 AppSecret / Token，绝不上传）----
/settings.json
/tokens.json

# ---- 真实用户数据（data/qa/quickref 均含个人笔记；server 首次启动自动生成空骨架）----
/data.json
/qa_data.json
/quickref_data.json
/ui_config.json

# ---- 运行时日志 / 缓存 ----
/botpy.log
/botpy.log.*
/__pycache__/
*.pyc

# ---- 自动备份与历史版本快照 ----
/backups/
/Release/

# ---- 开发机无关目录（教学参考 / 个人留存）----
/pic/
/_luogu/
/.trae/
/.workbuddy/

# ---- 内部文档（含个人信息，发布版不上传）----
/历史问题.md
/需求说明.md
/工作交接文档_交接前必看.md